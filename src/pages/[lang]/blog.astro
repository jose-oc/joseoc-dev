---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params;

const posts = await getCollection(lang as 'en' | 'es');
const sortedPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = [...new Set(posts.map(post => post.data.category))];

const t = {
  en: {
    title: "Blog",
    description: "All my posts about DevOps, AI, and Linux.",
    categories: "Categories",
    all: "All Posts"
  },
  es: {
    title: "Blog",
    description: "Todas mis publicaciones sobre DevOps, IA y Linux.",
    categories: "Categorías",
    all: "Todas las publicaciones"
  }
}[lang as 'en' | 'es'];
---

<Layout title={t.title} description={t.description} language={lang!}>
  <h1 class="text-4xl font-bold mb-4">{t.title}</h1>
  <p class="text-gray-600 dark:text-gray-400 mb-12">{t.description}</p>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
    <aside class="md:col-span-1">
      <h2 class="font-bold mb-4 uppercase text-sm tracking-widest text-gray-500">{t.categories}</h2>
      <ul class="space-y-2">
        {categories.map(cat => (
          <li>
            <a href={`/${lang}/category/${cat}`} class="text-gray-600 dark:text-gray-400 hover:text-blue-600 capitalize">
              {cat}
            </a>
          </li>
        ))}
      </ul>
    </aside>

    <div class="md:col-span-3 space-y-12">
      {sortedPosts.map(post => (
        <article>
          <time class="text-sm text-gray-500">{post.data.date.toLocaleDateString(lang === 'en' ? 'en-US' : 'es-ES')}</time>
          <h3 class="text-2xl font-bold hover:text-blue-600 mt-1">
            <a href={`/${lang}/${post.data.slug}`}>{post.data.title}</a>
          </h3>
          <p class="text-gray-600 dark:text-gray-400 mt-3">{post.data.description}</p>
          <div class="flex gap-2 mt-4">
            {post.data.tags.map(tag => (
              <span class="text-xs bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded text-gray-600 dark:text-gray-400">#{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
