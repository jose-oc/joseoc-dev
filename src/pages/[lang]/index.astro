---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params;
const docs = await getCollection('docs', (entry) => entry.id.startsWith(`${lang}/`));
---

<BaseLayout title={`Home - ${lang.toUpperCase()}`} lang={lang}>
  <div class="prose dark:prose-invert">
    <h1>Welcome to Jose's Documentation Site</h1>
    <p>Browse the available documentation below:</p>
    <ul>
      {docs.map((doc) => {
        const fallbackSlug = doc.id.split('/').slice(1).join('/').replace(/\.mdx?$/, '');
        const slug = doc.data.slug || fallbackSlug;
        return (
          <li>
            <a href={`/${lang}/docs/${slug}`}>{doc.data.title || fallbackSlug}</a>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>
