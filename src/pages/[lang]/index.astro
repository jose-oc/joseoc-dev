---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params;

const posts = await getCollection(lang as 'en' | 'es');
const latestPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const t = {
  en: {
    welcome: "Welcome to my personal site",
    intro: "I write about DevOps, AI, and Linux.",
    latest: "Latest Posts",
    viewAll: "View all posts"
  },
  es: {
    welcome: "Bienvenido a mi sitio personal",
    intro: "Escribo sobre DevOps, IA y Linux.",
    latest: "Últimas publicaciones",
    viewAll: "Ver todas las publicaciones"
  }
}[lang as 'en' | 'es'];
---

<Layout title="Jose OC" language={lang!}>
  <section class="py-12">
    <h1 class="text-5xl font-extrabold mb-4">{t.welcome}</h1>
    <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl">{t.intro}</p>
  </section>

  <section class="py-12">
    <div class="flex justify-between items-end mb-8">
      <h2 class="text-2xl font-bold">{t.latest}</h2>
      <a href={`/${lang}/blog`} class="text-blue-600 hover:underline">{t.viewAll} →</a>
    </div>
    
    <div class="space-y-8">
      {latestPosts.map(post => (
        <article>
          <time class="text-sm text-gray-500">{post.data.date.toLocaleDateString(lang === 'en' ? 'en-US' : 'es-ES')}</time>
          <h3 class="text-xl font-bold hover:text-blue-600">
            <a href={`/${lang}/${post.data.slug}`}>{post.data.title}</a>
          </h3>
          <p class="text-gray-600 dark:text-gray-400 mt-2">{post.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
