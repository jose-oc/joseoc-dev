---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  const docs = await getCollection('docs', (entry) => isProd ? !entry.data.draft : true);
  const blogs = await getCollection('blog', (entry) => isProd ? !entry.data.draft : true);
  const allContent = [...docs, ...blogs];

  // Get all languages
  const languages = [...new Set(allContent.map((item) => item.id.split('/')[0]))];
  const supportedLanguages = ['en', 'es'];
  const allLanguages = [...new Set([...languages, ...supportedLanguages])];

  // Get all unique tags
  const tags = new Set<string>();
  allContent.forEach((item) => {
    if (item.data.tags) {
      item.data.tags.forEach((tag) => tags.add(tag));
    }
  });

  const paths = [];
  allLanguages.forEach((lang) => {
    tags.forEach((tag) => {
      paths.push({
        params: { lang, tag },
      });
    });
  });

  return paths;
}

const { lang, tag } = Astro.params;
const isProd = import.meta.env.PROD;

const docs = await getCollection('docs', (entry) => {
  if (!entry.id.startsWith(`${lang}/`) || !entry.data.tags?.includes(tag)) return false;
  return isProd ? !entry.data.draft : true;
});
const blogs = await getCollection('blog', (entry) => {
  if (!entry.id.startsWith(`${lang}/`) || !entry.data.tags?.includes(tag)) return false;
  return isProd ? !entry.data.draft : true;
});

const allContent = [...docs, ...blogs].sort((a, b) => {
  const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
  const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
  return dateB - dateA; // Sort newest to oldest
});
---

<BaseLayout title={`Posts tagged with #${tag}`} description={`Explore all articles tagged with ${tag}`} lang={lang}>
  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <a href={`/${lang}/`} class="inline-flex items-center text-sm font-medium text-surface-500 hover:text-surface-900 dark:hover:text-surface-300 transition-colors mb-4">
        &larr; Back to Home
      </a>
      <h1 class="text-4xl font-extrabold text-surface-900 dark:text-surface-50">
        Tag: <span class="text-primary-600 dark:text-primary-500">#{tag}</span>
      </h1>
      <p class="mt-2 text-surface-600 dark:text-surface-400">Found {allContent.length} result(s).</p>
    </div>
    
    <div class="space-y-6">
      {allContent.map((post) => {
        const fallbackSlug = post.id.split('/').slice(1).join('/').replace(/\.mdx?$/, '');
        const slug = post.data.slug || fallbackSlug;
        const isBlog = post.collection === 'blog';
        const url = isBlog ? `/${lang}/blog/${slug}` : `/${lang}/docs/${slug}`;
        
        return (
          <article class="bg-surface-50 dark:bg-surface-800/50 p-6 rounded-xl border border-surface-200 dark:border-surface-700/50 hover:border-primary-300 dark:hover:border-primary-700 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-50">
                <a href={url} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                  {post.data.title || fallbackSlug}
                </a>
              </h2>
              <span class="text-xs font-mono px-2 py-1 bg-surface-200 dark:bg-surface-700 text-surface-700 dark:text-surface-300 rounded uppercase tracking-wider">
                {isBlog ? 'Blog' : 'Docs'}
              </span>
            </div>
            {post.data.description && (
              <p class="text-surface-700 dark:text-surface-300">
                {post.data.description}
              </p>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((t) => (
                  <a href={`/${lang}/tag/${t}`} class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-surface-200 hover:bg-surface-300 text-surface-800 dark:bg-surface-800 dark:hover:bg-surface-700 dark:text-surface-200 transition-colors">
                    #{t}
                  </a>
                ))}
              </div>
            )}
          </article>
        )
      })}
    </div>
  </div>
</BaseLayout>
