---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params;
---

<BaseLayout title="About Me" description="A little bit about who I am and what I do." lang={lang}>
  <div class="max-w-4xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-extrabold text-surface-900 dark:text-surface-50 tracking-tight mb-4">
        About Me
      </h1>
      <p class="text-xl text-surface-600 dark:text-surface-400 max-w-2xl mx-auto">
        I am a DevOps engineer, automation enthusiast, and lifelong learner.
      </p>
    </div>

    <div class="bg-surface-50 dark:bg-surface-800/50 p-8 sm:p-10 rounded-2xl border border-surface-200 dark:border-surface-700/50 shadow-sm">
      <article class="prose prose-surface dark:prose-invert prose-primary max-w-none prose-lg">
        <p>
          Hello! This is a placeholder for my "About" page. Eventually, I will populate this section with more detailed information about my career journey, my current focus in cloud infrastructure, and the specific technologies I love working with.
        </p>
        
        <h3>My Background</h3>
        <p>
          I've spent several years refining developer environments, optimizing continuous integration pipelines, and building robust cloud-native applications. I strongly believe in the power of "Infrastructure as Code" and automation to reduce human error and eliminate toil.
        </p>

        <h3>What I'm Working On</h3>
        <ul>
          <li>Optimizing Kubernetes cluster deployments.</li>
          <li>Refining my Neovim setup for maximum efficiency.</li>
          <li>Writing technical documentation to share my knowledge.</li>
        </ul>

        <h3>Get in Touch</h3>
        <p>
          You can find my code on <a href="https://github.com/jose-oc" target="_blank" rel="noopener noreferrer">GitHub</a>. Stay tuned as I continue to update this space with real content, experiences, and thoughts on software engineering!
        </p>
      </article>
    </div>
  </div>
</BaseLayout>
