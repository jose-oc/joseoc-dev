---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" lang="en">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4 animate-fade-in">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-500 mb-8">
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
    </div>
    
    <h1 class="text-4xl sm:text-6xl font-extrabold text-surface-900 dark:text-surface-50 tracking-tight mb-4">
      404
    </h1>
    <h2 class="text-2xl font-semibold text-surface-700 dark:text-surface-300 mb-6">
      Page not found
    </h2>
    <p class="text-lg text-surface-500 dark:text-surface-400 max-w-md mb-10">
      Sorry, we couldn't find the page you're looking for. It might have been moved or deleted.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="/" class="inline-flex items-center justify-center px-6 py-3 rounded-lg text-sm font-medium text-white bg-primary-600 hover:bg-primary-500 transition-colors shadow-sm">
        Back to Home
      </a>
      <a href="/docs" class="inline-flex items-center justify-center px-6 py-3 rounded-lg text-sm font-medium text-surface-700 dark:text-surface-300 bg-surface-100 hover:bg-surface-200 dark:bg-surface-800 dark:hover:bg-surface-700 transition-colors">
        Browse Docs
      </a>
    </div>
  </div>
</BaseLayout>
