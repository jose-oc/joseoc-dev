---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  slug?: string;
  noindex?: boolean;
  image?: string;
  availableLangs?: string[];
}

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://www.joseoc.dev';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const canonicalURLString = canonicalURL.toString().replace(/\/$/, '');

const { title, description, lang = 'en', slug, noindex = false, image, availableLangs: propsAvailableLangs } = Astro.props;

const defaultDescriptions: Record<string, string> = {
  en: 'IT Documentation, DevOps guides, and technical articles by Jose Ortiz.',
  es: 'Documentación técnica de TI, guías de DevOps y artículos técnicos de Jose Ortiz.'
};

const metaDescription = description || defaultDescriptions[lang] || defaultDescriptions.en;

const ogImage = image ? new URL(image, siteUrl) : new URL('/favicon.svg', siteUrl);

// Check which languages are available for this slug
let availableLangs = propsAvailableLangs || ['en', 'es'];
let currentItem: any = null;
if (slug) {
  const docs = await getCollection('docs');
  const blogs = await getCollection('blog');
  const allContent = [...docs, ...blogs];
  
  const matched = allContent.filter(d => {
    const dSlug = d.data.slug || d.id.split('/').slice(1).join('/').replace(/\.mdx?$/, '');
    return dSlug === slug;
  });
  
  availableLangs = matched.map(d => d.id.split('/')[0]);
  currentItem = matched.find(d => d.id.startsWith(`${lang}/`));
}

// JSON-LD Structured Data
let jsonLd: any = null;
if (currentItem) {
  const isBlog = currentItem.collection === 'blog';
  const type = isBlog ? 'BlogPosting' : 'TechArticle';
  
  jsonLd = {
    "@context": "https://schema.org",
    "@type": type,
    "headline": title || currentItem.data.title,
    "description": metaDescription || currentItem.data.description,
    "url": canonicalURLString,
    "inLanguage": lang,
  };
  
  if (currentItem.data.pubDate) {
    jsonLd.datePublished = currentItem.data.pubDate instanceof Date 
      ? currentItem.data.pubDate.toISOString() 
      : new Date(currentItem.data.pubDate).toISOString();
  }
  
  // Author
  const authorName = isBlog ? (currentItem.data.author || 'Jose Ortiz') : 'Jose Ortiz';
  jsonLd.author = {
    "@type": "Person",
    "name": authorName,
    "url": siteUrl,
    "sameAs": [
      siteConfig.social.linkedin,
      siteConfig.social.twitter,
      siteConfig.social.github
    ].filter(Boolean)
  };

  // Publisher
  jsonLd.publisher = {
    "@type": "Organization",
    "name": "Jose Ortiz",
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/favicon.svg', siteUrl).toString()
    }
  };
} else if (Astro.url.pathname === '/' || Astro.url.pathname === '/es' || Astro.url.pathname === '/es/') {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Jose Ortiz",
    "url": siteUrl,
    "description": metaDescription,
    "author": {
      "@type": "Person",
      "name": "Jose Ortiz",
      "sameAs": [
        siteConfig.social.linkedin,
        siteConfig.social.twitter,
        siteConfig.social.github
      ].filter(Boolean)
    }
  };
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    
    <link rel="canonical" href={canonicalURLString} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={slug ? "article" : "website"} />
    <meta property="og:url" content={canonicalURLString} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:site_name" content="Jose Ortiz" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURLString} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

      // Listen for OS theme changes
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          if (e.matches) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
      });
    </script>
    {(() => {
      const segments = Astro.url.pathname.split('/').filter(Boolean);
      const hasLangPrefix = segments[0] === 'es';
      const pathSegments = hasLangPrefix ? segments.slice(1) : segments;
      const pathWithoutLang = pathSegments.join('/');
      
      const enUrl = pathWithoutLang ? `${siteUrl}/${pathWithoutLang}` : siteUrl;
      const esUrl = pathWithoutLang ? `${siteUrl}/es/${pathWithoutLang}` : `${siteUrl}/es`;
      
      return (
        <>
          {slug && availableLangs.includes(lang) && (
            <link rel="alternate" type="text/markdown" href={`${siteUrl}/raw${lang === 'es' ? '/es' : ''}/${slug}.md`} />
          )}
          {availableLangs.includes('en') && (
            <link rel="alternate" hreflang="en" href={enUrl} />
          )}
          {availableLangs.includes('es') && (
            <link rel="alternate" hreflang="es" href={esUrl} />
          )}
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      );
    })()}
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-surface-50 dark:bg-surface-950">
    <Header lang={lang} />
    <main class="flex-grow w-full mx-auto transition-all duration-500 ease-in-out [.focus-mode_&]:px-8" data-pagefind-body>
      <slot />
    </main>
    <footer class="py-8 text-center text-sm text-surface-500 border-t border-surface-200 dark:border-surface-800 mt-12 flex flex-col items-center gap-4">
      <div class="flex gap-4">
        {siteConfig.social.twitter && (
          <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer" class="hover:text-surface-900 dark:hover:text-surface-50 transition-colors" aria-label="Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
            </svg>
          </a>
        )}
        {siteConfig.social.linkedin && (
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-surface-900 dark:hover:text-surface-50 transition-colors" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
            </svg>
          </a>
        )}
        {siteConfig.social.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="hover:text-surface-900 dark:hover:text-surface-50 transition-colors" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </a>
        )}
      </div>
      <div class="flex flex-col items-center gap-2">
        <div>Jose Ortiz &copy; {new Date().getFullYear()}</div>
        <a href={lang === 'es' ? '/es/privacy' : '/privacy'} class="text-xs text-surface-400 hover:text-primary-600 dark:hover:text-primary-500 transition-colors underline-offset-4 hover:underline">
          {lang === 'es' ? 'Política de Privacidad' : 'Privacy Policy'}
        </a>
      </div>
    </footer>
    
    <script>
      document.addEventListener('DOMContentLoaded', async () => {
        // --- Code Copy Button ---
        const preElements = document.querySelectorAll('pre:not(.mermaid)');
        
        preElements.forEach((pre) => {
          const wrapper = document.createElement('div');
          wrapper.className = 'relative group';
          pre.parentNode?.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          const copyButton = document.createElement('button');
          copyButton.className = 'absolute top-3 right-3 p-1.5 rounded-md bg-surface-700/80 hover:bg-surface-600 text-surface-300 hover:text-white opacity-0 group-hover:opacity-100 transition-all border border-surface-600 backdrop-blur-sm z-10';
          copyButton.setAttribute('aria-label', 'Copy code to clipboard');
          copyButton.title = 'Copy code';
          
          const copyIcon = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>`;
          const checkIcon = `<svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
          
          copyButton.innerHTML = copyIcon;

          copyButton.addEventListener('click', async () => {
            const codeText = pre.innerText;
            try {
              await navigator.clipboard.writeText(codeText);
              copyButton.innerHTML = checkIcon;
              setTimeout(() => {
                copyButton.innerHTML = copyIcon;
              }, 2000);
            } catch (err) {
              console.error('Failed to copy text: ', err);
            }
          });

          wrapper.appendChild(copyButton);
        });

        // --- Image/Mermaid Zoom Lightbox ---
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const isImage = target.tagName === 'IMG' && target.closest('.prose');
          const isMermaid = target.closest('svg[id^="mermaid-"]');
          
          if ((isImage || isMermaid) && !target.closest('.mermaid-modal')) {
            const modal = document.createElement('div');
            modal.className = 'mermaid-modal'; // We reuse the same class for styling
            
            let content: HTMLElement | SVGElement;
            if (isImage) {
              const img = document.createElement('img');
              img.src = (target as HTMLImageElement).src;
              img.alt = (target as HTMLImageElement).alt;
              img.className = 'max-w-full max-h-full h-auto w-auto bg-white rounded-2xl shadow-2xl animate-fade-in';
              content = img;
            } else {
              const svg = target.closest('svg')!;
              const clone = svg.cloneNode(true) as SVGElement;
              clone.removeAttribute('style');
              clone.removeAttribute('width');
              clone.removeAttribute('height');
              clone.setAttribute('class', 'max-w-full max-h-full h-auto w-auto bg-white rounded-2xl p-6 sm:p-10 shadow-2xl animate-fade-in');
              content = clone;
            }
            
            modal.appendChild(content);
            document.body.appendChild(modal);
            document.body.style.overflow = 'hidden';
            
            modal.onclick = () => {
              modal.remove();
              document.body.style.overflow = '';
            };

            const handleEsc = (e: KeyboardEvent) => {
              if (e.key === 'Escape') {
                modal.remove();
                document.body.style.overflow = '';
                document.removeEventListener('keydown', handleEsc);
              }
            };
            document.addEventListener('keydown', handleEsc);
          }
        });

        // --- Client-side Mermaid rendering ---
        const mermaidElements = document.querySelectorAll('.mermaid');
        if (mermaidElements.length > 0) {
          try {
            const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
            mermaid.initialize({
              startOnLoad: false,
              theme: document.documentElement.classList.contains('dark') ? 'dark' : 'neutral',
              securityLevel: 'loose',
            });
            await mermaid.run({
              nodes: Array.from(mermaidElements)
            });
          } catch (err) {
            console.error('Failed to render mermaid diagrams:', err);
          }
        }
      });
    </script>
  </body>
</html>
