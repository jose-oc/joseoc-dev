---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import ReadingControls from '../components/ReadingControls.astro';

interface Props {
  title: string;
  description?: string;
  lang: string;
  slug: string;
  headings: any[];
  tags?: string[];
  category?: string;
}

const { title, description, lang, slug, headings, tags = [], category } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang} slug={slug}>
  <!-- Mobile Doc Navigation Sub-header (only visible on mobile/tablet) -->
  <div class="sticky top-16 z-30 flex items-center justify-between w-full h-12 border-b border-surface-200 dark:border-surface-800 bg-surface-50/80 dark:bg-surface-950/80 backdrop-blur-md px-4 xl:hidden">
    <!-- Left Toggle -->
    <button 
      id="toggle-left-sidebar" 
      type="button" 
      class="flex items-center gap-2 text-sm font-medium text-surface-600 dark:text-surface-400 hover:text-surface-900 dark:hover:text-surface-50 transition-colors lg:hidden"
      aria-label="Toggle document outline menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/>
      </svg>
      <span>{lang === 'es' ? 'Menú' : 'Menu'}</span>
    </button>

    <!-- Right Toggle (only shown if there are headings to display) -->
    {headings.filter(h => h.depth > 1 && h.depth < 4).length > 0 && (
      <button 
        id="toggle-right-sidebar" 
        type="button" 
        class="flex items-center gap-2 text-sm font-medium text-surface-600 dark:text-surface-400 hover:text-surface-900 dark:hover:text-surface-50 transition-colors xl:hidden ml-auto"
        aria-label="Toggle table of contents"
      >
        <span>{lang === 'es' ? 'En esta página' : 'On this page'}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="21" x2="3" y1="6" y2="6"/><line x1="21" x2="9" y1="12" y2="12"/><line x1="21" x2="7" y1="18" y2="18"/><path d="M3 12h.01"/><path d="M3 18h.01"/>
        </svg>
      </button>
    )}
  </div>

  <div class="doc-layout-wrapper max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 transition-all duration-500 ease-in-out [.focus-mode_&]:max-w-none [.focus-mode_&]:px-0">
    <div class="doc-layout-grid grid grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,1fr)_16rem] gap-8 xl:gap-12 w-full transition-all duration-500 ease-in-out">
      <!-- Left Sidebar (Drawer on mobile, sticky sidebar on desktop) -->
      <aside 
        id="left-sidebar" 
        class="sidebar-wrapper fixed inset-y-0 left-0 z-50 w-72 max-w-[80vw] bg-surface-50 dark:bg-surface-950 p-6 border-r border-surface-200 dark:border-surface-800 shadow-2xl transform -translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto lg:static lg:block lg:w-64 lg:h-[calc(100vh-6rem)] lg:p-0 lg:border-r-0 lg:shadow-none lg:transform-none lg:transition-none sticky lg:top-24 lg:self-start lg:pr-6 lg:py-6"
      >
        <div class="flex justify-end lg:hidden mb-4 border-b border-surface-200 dark:border-surface-800 pb-2">
          <button 
            id="close-left-sidebar" 
            type="button" 
            class="p-1 text-surface-500 hover:text-surface-900 dark:hover:text-surface-50 hover:bg-surface-100 dark:hover:bg-surface-800 rounded-lg border border-transparent"
            aria-label="Close menu"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <Sidebar lang={lang} currentSlug={slug} />
      </aside>
      
      <!-- Main Content -->
      <article class="flex-grow min-w-0 py-8 animate-fade-in transition-all duration-500 ease-in-out">
        <header class="mb-12 border-b border-surface-200 dark:border-surface-800 pb-12">
          {category && (
            <a href={lang === 'es' ? `/es/category/${category}` : `/category/${category}`} class="text-xs font-bold tracking-widest uppercase text-primary-600 dark:text-primary-500 hover:text-primary-700 dark:hover:text-primary-400 transition-colors mb-4 block">
              {category}
            </a>
          )}
          <h1 class="text-4xl sm:text-5xl font-black text-surface-900 dark:text-surface-50 mb-6 tracking-tight leading-tight">
            {title}
          </h1>
          {description && (
            <p class="text-xl text-surface-600 dark:text-surface-400 max-w-3xl leading-relaxed font-medium">
              {description}
            </p>
          )}
          
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-8">
              {tags.map(tag => (
                <a href={lang === 'es' ? `/es/tag/${tag}` : `/tag/${tag}`} class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-surface-100 hover:bg-surface-200 text-surface-700 dark:bg-surface-800 dark:hover:bg-surface-700 dark:text-surface-300 border border-surface-200 dark:border-surface-700 transition-all hover:scale-105">
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <div class="prose prose-surface dark:prose-invert prose-primary max-w-none 
                    prose-headings:scroll-mt-24 
                    prose-a:no-underline hover:prose-a:underline prose-a:font-semibold prose-a:text-primary-600 dark:prose-a:text-primary-500
                    prose-pre:border prose-pre:border-surface-200 dark:prose-pre:border-surface-800 prose-pre:shadow-sm
                    prose-img:rounded-2xl prose-img:border prose-img:border-surface-200 dark:prose-img:border-surface-800 shadow-sm
                    transition-all duration-300">
          <slot />
        </div>
      </article>

      <!-- Right TOC (Drawer on mobile, sticky sidebar on desktop) -->
      {headings.filter(h => h.depth > 1 && h.depth < 4).length > 0 && (
        <aside 
          id="right-sidebar" 
          class="toc-wrapper fixed inset-y-0 right-0 z-50 w-72 max-w-[80vw] bg-surface-50 dark:bg-surface-950 p-6 border-l border-surface-200 dark:border-surface-800 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto xl:static xl:block xl:w-64 xl:h-[calc(100vh-6rem)] xl:p-0 xl:border-l-0 xl:shadow-none xl:transform-none xl:transition-none sticky xl:top-24 xl:self-start xl:pl-6 xl:py-6"
        >
          <div class="flex justify-start xl:hidden mb-4 border-b border-surface-200 dark:border-surface-800 pb-2">
            <button 
              id="close-right-sidebar" 
              type="button" 
              class="p-1 text-surface-500 hover:text-surface-900 dark:hover:text-surface-50 hover:bg-surface-100 dark:hover:bg-surface-800 rounded-lg border border-transparent"
              aria-label="Close table of contents"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
          <Toc headings={headings} />
        </aside>
      )}
    </div>
  </div>

  <!-- Backdrop for mobile drawers -->
  <div 
    id="sidebar-backdrop" 
    class="fixed inset-0 bg-surface-950/50 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300 pointer-events-none"
  ></div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const leftSidebar = document.getElementById('left-sidebar');
    const rightSidebar = document.getElementById('right-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const toggleLeft = document.getElementById('toggle-left-sidebar');
    const toggleRight = document.getElementById('toggle-right-sidebar');
    const closeLeft = document.getElementById('close-left-sidebar');
    const closeRight = document.getElementById('close-right-sidebar');

    function openSidebar(sidebar: HTMLElement) {
      if (!backdrop || !sidebar) return;
      backdrop.classList.remove('hidden');
      // Force layout reflow to enable transition
      backdrop.offsetHeight;
      backdrop.classList.add('opacity-100');
      backdrop.classList.remove('pointer-events-none');
      
      sidebar.classList.add('translate-x-0');
      if (sidebar.id === 'left-sidebar') {
        sidebar.classList.remove('-translate-x-full');
      } else {
        sidebar.classList.remove('translate-x-full');
      }
      document.body.classList.add('overflow-hidden');
    }

    function closeAll() {
      if (leftSidebar) {
        leftSidebar.classList.remove('translate-x-0');
        leftSidebar.classList.add('-translate-x-full');
      }
      if (rightSidebar) {
        rightSidebar.classList.remove('translate-x-0');
        rightSidebar.classList.add('translate-x-full');
      }
      
      if (backdrop) {
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('pointer-events-none');
        setTimeout(() => {
          const isLeftClosed = leftSidebar ? !leftSidebar.classList.contains('translate-x-0') : true;
          const isRightClosed = rightSidebar ? !rightSidebar.classList.contains('translate-x-0') : true;
          if (isLeftClosed && isRightClosed) {
            backdrop.classList.add('hidden');
          }
        }, 300);
      }
      document.body.classList.remove('overflow-hidden');
    }

    toggleLeft?.addEventListener('click', () => {
      if (leftSidebar) openSidebar(leftSidebar);
    });

    toggleRight?.addEventListener('click', () => {
      if (rightSidebar) openSidebar(rightSidebar);
    });

    closeLeft?.addEventListener('click', closeAll);
    closeRight?.addEventListener('click', closeAll);
    backdrop?.addEventListener('click', closeAll);

    // Escape key handling
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });

    // Close drawers on link click (e.g. anchor scrolling)
    const drawerLinks = document.querySelectorAll('.sidebar-wrapper a, .toc-wrapper a');
    drawerLinks.forEach(link => {
      link.addEventListener('click', closeAll);
    });
  });
</script>

<style is:global>
  @reference "../styles/global.css";
  
  /* Focus Mode Styles */
  .focus-mode .sidebar-wrapper,
  .focus-mode .toc-wrapper {
    display: none !important;
  }

  .focus-mode .doc-layout-grid {
    grid-template-columns: 1fr !important;
    gap: 0 !important;
  }

  .focus-mode article {
    @apply max-w-none w-full mx-auto px-4 sm:px-8 lg:px-12 pt-0;
  }

  /* Hide scrollbars but allow scrolling */
  .sidebar-wrapper, .toc-wrapper {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE and Edge */
  }
  .sidebar-wrapper::-webkit-scrollbar, .toc-wrapper::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }
</style>
