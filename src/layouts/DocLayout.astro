---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import ReadingControls from '../components/ReadingControls.astro';

interface Props {
  title: string;
  description?: string;
  lang: string;
  slug: string;
  headings: any[];
  tags?: string[];
  category?: string;
}

const { title, description, lang, slug, headings, tags = [], category } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang} slug={slug}>
  <div class="doc-layout-wrapper max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 transition-all duration-500 ease-in-out [.focus-mode_&]:max-w-none [.focus-mode_&]:px-0">
    <div class="doc-layout-grid grid grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,1fr)_16rem] gap-8 xl:gap-12 w-full transition-all duration-500 ease-in-out">
      <!-- Left Sidebar -->
      <aside class="sidebar-wrapper hidden lg:block sticky top-24 self-start h-[calc(100vh-6rem)] overflow-y-auto transition-all duration-500 ease-in-out">
        <div class="pr-4 pb-20">
          <Sidebar lang={lang} currentSlug={slug} />
        </div>
      </aside>
      
      <!-- Main Content -->
      <article class="flex-grow min-w-0 py-8 animate-fade-in transition-all duration-500 ease-in-out">
        <header class="mb-12 border-b border-surface-200 dark:border-surface-800 pb-12">
          {category && (
            <a href={`/${lang}/category/${category}`} class="text-xs font-bold tracking-widest uppercase text-primary-600 dark:text-primary-500 hover:text-primary-700 dark:hover:text-primary-400 transition-colors mb-4 block">
              {category}
            </a>
          )}
          <h1 class="text-4xl sm:text-5xl font-black text-surface-900 dark:text-surface-50 mb-6 tracking-tight leading-tight">
            {title}
          </h1>
          {description && (
            <p class="text-xl text-surface-600 dark:text-surface-400 max-w-3xl leading-relaxed font-medium">
              {description}
            </p>
          )}
          
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-8">
              {tags.map(tag => (
                <a href={`/${lang}/tag/${tag}`} class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-surface-100 hover:bg-surface-200 text-surface-700 dark:bg-surface-800 dark:hover:bg-surface-700 dark:text-surface-300 border border-surface-200 dark:border-surface-700 transition-all hover:scale-105">
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <div class="prose prose-surface dark:prose-invert prose-primary max-w-none 
                    prose-headings:scroll-mt-24 
                    prose-a:no-underline hover:prose-a:underline prose-a:font-semibold prose-a:text-primary-600 dark:prose-a:text-primary-500
                    prose-pre:border prose-pre:border-surface-200 dark:prose-pre:border-surface-800 prose-pre:shadow-sm
                    prose-img:rounded-2xl prose-img:border prose-img:border-surface-200 dark:prose-img:border-surface-800 shadow-sm
                    transition-all duration-300">
          <slot />
        </div>
      </article>

      <!-- Right TOC -->
      <aside class="toc-wrapper hidden xl:block sticky top-24 self-start h-[calc(100vh-6rem)] overflow-y-auto transition-all duration-500 ease-in-out">
        <div class="pl-4 pb-20">
          <Toc headings={headings} />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style is:global>
  @reference "../styles/global.css";
  
  /* Focus Mode Styles */
  .focus-mode .sidebar-wrapper,
  .focus-mode .toc-wrapper {
    display: none !important;
  }

  .focus-mode .doc-layout-grid {
    grid-template-columns: 1fr !important;
    gap: 0 !important;
  }

  .focus-mode article {
    @apply max-w-none w-full mx-auto px-4 sm:px-8 lg:px-12 pt-0;
  }

  /* Hide scrollbars but allow scrolling */
  .sidebar-wrapper, .toc-wrapper {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE and Edge */
  }
  .sidebar-wrapper::-webkit-scrollbar, .toc-wrapper::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }
</style>
