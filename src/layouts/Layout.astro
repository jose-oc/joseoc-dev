---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	language: string;
	alternateUrl?: string;
}

const { title, description, language, alternateUrl } = Astro.props;
const siteUrl = Astro.site || 'https://joseoc.com';
const currentUrl = new URL(Astro.url.pathname, siteUrl);

const otherLang = language === 'en' ? 'es' : 'en';
const defaultAlternateUrl = alternateUrl || (language === 'en' ? `/es${Astro.url.pathname.substring(3)}` : `/en${Astro.url.pathname.substring(3)}`);
---

<!doctype html>
<html lang={language}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- SEO Meta Tags -->
		<link rel="canonical" href={currentUrl} />
		<link rel="alternate" hreflang="en" href={new URL('/en/', siteUrl)} />
		<link rel="alternate" hreflang="es" href={new URL('/es/', siteUrl)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/en/', siteUrl)} />
		
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={currentUrl} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100 min-h-screen flex flex-col font-sans">
		<header class="border-b border-gray-200 dark:border-gray-800 sticky top-0 bg-white/80 dark:bg-gray-950/80 backdrop-blur-md z-10">
			<nav class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
				<a href={`/${language}`} class="font-bold text-xl tracking-tighter">JOSE<span class="text-blue-600">OC</span></a>
				<div class="flex items-center gap-6 text-sm font-medium">
					<a href={`/${language}/blog`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Blog</a>
					<a href={`/${language}/search`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Search</a>
					<a href={`/${language}/about`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">About</a>
					<a href={defaultAlternateUrl} class="uppercase text-[10px] font-bold border border-gray-300 dark:border-gray-700 px-1.5 py-0.5 rounded hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
						{otherLang}
					</a>
				</div>
			</nav>
		</header>
		<main class="max-w-4xl mx-auto px-4 py-12 w-full">
			<slot />
		</main>
		<footer class="border-t border-gray-200 dark:border-gray-800 py-12 text-center text-sm text-gray-500">
			<div class="max-w-4xl mx-auto px-4">
				<p>&copy; {new Date().getFullYear()} Jose OC. Built with Astro & TailwindCSS.</p>
			</div>
		</footer>
	</body>
</html>
