[0.000, "o", ";mUT\u001b[0m\u001b[;38;5;108mH\u001b[0m\u001b[;m_SOCK\"\u001b[0m\u001b[;m                                                                                                                                                           \r\u001b[187C\u001b[;m \r\u001b[187C\u001b[;38;5;59m│\u001b[0m\u001b[3A\r\u001b[;38;5;236m▌\u001b[0m\u001b[;m \u001b[;m236     ssh-add \u001b[0m\u001b[;38;5;108m-\u001b[0m\u001b[;m\u001b[0m\u001b[;38;5;108ml\u001b[0m\u001b[;m                                                                                                                                                                       \r\u001b[187C\u001b[;m \r\u001b[187C\u001b[;38;5;59m│\u001b[0m\u001b[1B\r\u001b[;38;5;236m▌\u001b[0m\u001b[;m \u001b[;m        git -c credenti\u001b[0m\u001b[;38;5;108ma\u001b[0m\u001b[;ml.\u001b[0m\u001b[;38;5;108mh\u001b[0m\u001b[;melper= -c core.askPass= -c credential.interactive=never \\\u001b[0m\u001b[;m                                                                                                     \r\u001b[187C\u001b[;m \r\u001b[187C\u001b[;38;5;59m│\u001b[0m\u001b[1B\r\u001b[;38;5;236m▌\u001b[0m\u001b[;m \u001b[;m          \u001b[0m\u001b[;38;5;108ml\u001b[0m\u001b[;m\u001b[0m\u001b[;38;5;108ms\u001b[0m\u001b[;m-remote https://github.com/Homebrew/brew.git\u001b[0m\u001b[;m                              "]
