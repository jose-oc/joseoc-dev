---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth > 1 && h.depth < 4);
---

{filteredHeadings.length > 0 && (
  <nav class="w-full" aria-label="Table of contents">
    <h3 class="font-semibold text-surface-900 dark:text-surface-50 mb-3 text-sm uppercase tracking-wider">On this page</h3>
    <ul class="space-y-2 border-l border-surface-200 dark:border-surface-800">
      {filteredHeadings.map(heading => (
        <li>
          <a 
            href={`#${heading.slug}`} 
            class={`block text-sm text-surface-500 hover:text-primary-600 dark:hover:text-primary-500 transition-colors ${heading.depth === 3 ? 'ml-4' : 'ml-0'} pl-4 border-l -ml-[1px] border-transparent hover:border-primary-500`}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
