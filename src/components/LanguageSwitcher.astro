---
import { getCollection } from 'astro:content';

const { pathname } = Astro.url;

// Extract current language and the rest of the path
const segments = pathname.split('/').filter(Boolean);
const hasLangPrefix = segments[0] === 'es';
const currentLang = hasLangPrefix ? 'es' : 'en';
const toggleLang = currentLang === 'en' ? 'es' : 'en';

// Path without language prefix
const pathSegments = hasLangPrefix ? segments.slice(1) : segments;

const isDoc = pathSegments[0] === 'docs';
const isBlog = pathSegments[0] === 'blog';
const slug = (isDoc || isBlog) ? pathSegments.slice(1).join('/') : null;

let toggleUrl = toggleLang === 'es' ? '/es/' : '/';

const buildUrl = (l: string, pSegments: string[]) => {
  const prefix = l === 'es' ? '/es' : '';
  const path = pSegments.join('/');
  return `${prefix}/${path}`;
};

const isTag = pathSegments[0] === 'tag';
const isCategory = pathSegments[0] === 'category';

if (slug) {
  const collection = isDoc ? 'docs' : 'blog';
  const content = await getCollection(collection as any);
  const translationExists = content.some(d => {
    const dLang = d.id.split('/')[0];
    const dSlug = d.data.slug || d.id.split('/').slice(1).join('/').replace(/\.mdx?$/, '');
    return dLang === toggleLang && dSlug === slug;
  });
  
  if (translationExists) {
    toggleUrl = buildUrl(toggleLang, pathSegments);
  } else {
    // If no translation exists, fallback to the section index (e.g. /es/docs)
    toggleUrl = buildUrl(toggleLang, [pathSegments[0]]);
  }
} else if (isTag) {
  const tag = pathSegments[1];
  const docs = await getCollection('docs');
  const blogs = await getCollection('blog');
  const allContent = [...docs, ...blogs];
  const hasContent = allContent.some(d => {
    const dLang = d.id.split('/')[0];
    return dLang === toggleLang && d.data.tags?.includes(tag);
  });
  if (hasContent) {
    toggleUrl = buildUrl(toggleLang, pathSegments);
  } else {
    toggleUrl = toggleLang === 'es' ? '/es/' : '/';
  }
} else if (isCategory) {
  const category = pathSegments[1];
  const docs = await getCollection('docs');
  const blogs = await getCollection('blog');
  const allContent = [...docs, ...blogs];
  const hasContent = allContent.some(d => {
    const dLang = d.id.split('/')[0];
    return dLang === toggleLang && d.data.category === category;
  });
  if (hasContent) {
    toggleUrl = buildUrl(toggleLang, pathSegments);
  } else {
    toggleUrl = toggleLang === 'es' ? '/es/' : '/';
  }
} else if (pathSegments.length > 0) {
  // For other pages (about, privacy)
  toggleUrl = buildUrl(toggleLang, pathSegments);
}
---

<a 
  href={toggleUrl}
  class="flex items-center gap-2 px-3 py-1.5 text-sm font-medium rounded-md border border-surface-200 dark:border-surface-800 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors"
  aria-label={`Switch to ${toggleLang === 'en' ? 'English' : 'Spanish'}`}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-surface-500"><path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/></svg>
  <span class="uppercase">{currentLang}</span>
</a>
